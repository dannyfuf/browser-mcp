{
  "lock": true,
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A src/index.ts",
    "check": "deno check src/ test/",
    "lint": "deno run -A npm:@biomejs/biome check .",
    "test": "deno test -A test/",
    "build": "deno run -A npm:esbuild@0.28.2 src/index.ts --bundle --platform=node --format=esm --banner:js='import { createRequire } from \"node:module\"; const require = createRequire(import.meta.url);' --outfile=dist/browser-mcp.js"
  },
  "imports": {
    "@std/expect": "jsr:@std/expect@^1.0.20",
    "@std/testing": "jsr:@std/testing@^1.0.20"
  },
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable", "deno.ns"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false
  },
  "allowScripts": ["npm:puppeteer"]
}
